# Copy to .env for local development. Never commit .env.
APP_NAME=VoteTrail
DJANGO_SETTINGS_MODULE=votetrail.settings.dev
SECRET_KEY=change-me
# python -c "import secrets;print(secrets.token_urlsafe(32))"
PHONE_HMAC_KEY=change-me
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Empty = SQLite (local). Set to a Postgres URL in production (ThalesOps).
DATABASE_URL=
LOG_LEVEL=INFO

# Azure OpenAI Responses API (text + vision)
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# Azure gpt-realtime (voice assistant + voice-note understanding)
AZURE_REALTIME_ENDPOINT=
AZURE_REALTIME_DEPLOYMENT=
AZURE_REALTIME_API_KEY=
# ElevenLabs text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_PCM=
# Tavily public-source search
TAVILY_API_KEY=
# Mapbox (optional directions)
MAPBOX_PUBLIC_TOKEN=
# outbox (default, simulated) | africastalking (real SMS/voice)
NOTIFY_BACKEND=outbox
AT_USERNAME=sandbox
AT_API_KEY=

# Trust engine (optional overrides)
PU_RADIUS_M=300
CLAIM_WINDOW_HOURS=3
EXTRACTION_MIN_CONFIDENCE=0.85
TRUSTED_AUTHORITIES=
OFFICIAL_ANNOUNCEMENT_SOURCES=inecnigeria.org,x.com/inecnigeria
DATA_RETENTION_DAYS=180
