msgstr "An ruwaito matsalar BVAS"

#, python-format
msgid "Open since %(time)s"
msgstr "A bude tun %(time)s"

msgid "Not open yet (crowd reports)"
msgstr "Ba a bude ba tukuna (rahoton jama'a)"

msgid "No updates yet"
msgstr "Babu sabon labari tukuna"

