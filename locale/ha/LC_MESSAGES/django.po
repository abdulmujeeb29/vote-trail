msgstr "San rumfarka"

msgid "Election day"
msgstr "Ranar zabe"

msgid "TODAY"
msgstr "YAU"

msgid "Check the result"
msgstr "Duba sakamako"

msgid "NOW"
msgstr "YANZU"

msgid "OPEN"
msgstr "A BUDE"

msgid "AFTER COUNT"
msgstr "BAYAN KIRGA"

msgid "Accessibility help"
msgstr "Taimako ga tsofaffi da nakasassu"

