msgstr "BAYANI"

#, python-format
msgid "%(what)s at %(time)s (polling official)"
msgstr "%(what)s da karfe %(time)s (jami'in zabe)"

#, python-format
msgid "%(what)s: reported by %(n)d people"
msgstr "%(what)s: mutane %(n)d sun ruwaito"

